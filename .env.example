# ═══════════════════════════════════════════════════════════════════
# HoneyDesk 蜜方 · 环境配置示例  →  复制为 .env 后按需修改
# ═══════════════════════════════════════════════════════════════════

# ---------- 大模型（用户自定义，不锁定模型） ----------
# 兼容 OpenAI 协议即可（OpenAI / 通义 / DeepSeek / 本地 Ollama / vLLM …）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
# 可选备用模型（意图/分类等轻任务），留空则统一走 LLM_MODEL
LLM_LIGHT_MODEL=

# ---------- 本地向量模型（可选，未装自动降级） ----------
# 模型目录：backend/models 或 compose 的 model_cache 卷
EMBEDDING_MODEL_PATH=models/bge-m3
RERANK_MODEL_PATH=models/bge-reranker-v2-m3
# auto=装了 FlagEmbedding 用 BGE，否则用内置轻量 embedding；可手动指定 bge | fallback
EMBEDDING_BACKEND=auto

# ---------- MySQL ----------
# 使用【本机已安装的 MySQL】，不用 Docker。
# 分库：honey_desk=业务库（商品/订单/库存/广告），honey_system=系统库（对话/审批/知识库/配置）。
# MYSQL_DATABASE 为连接默认库（所有表均以 schema 限定，默认库仅需已存在）。
# 本地独立运行后端时用 localhost；Docker 跑后端连本机 MySQL 用 host.docker.internal
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=honey_system

# ---------- Qdrant ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=honeydesk_kb

# ---------- 应用 ----------
APP_PORT=8000
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 调度/审批 ----------
APPROVAL_TIMEOUT_HOURS=24
RAG_TOP_K=5
LOW_CONFIDENCE_THRESHOLD=0.35